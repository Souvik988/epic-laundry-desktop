{
  "name": "epic-bos-server",
  "version": "0.0.1-phase0",
  "private": true,
  "type": "module",
  "description": "Epic BOS Phase-0 kernel: metadata-driven Schema Registry, posting engine, event outbox, audit, and WhatsApp connector to shortlinXchat.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:laundry": "tsx src/_selftest-laundry.ts",
    "test:auth": "tsx src/_selftest-auth.ts",
    "test:store-migration": "tsx src/_selftest-store-migration.ts",
    "test:customer": "tsx src/_selftest-customer.ts",
    "test:package": "tsx src/_selftest-package.ts",
    "test:catalogue": "tsx src/_selftest-catalogue.ts",
    "test:payment": "tsx src/_selftest-payment.ts",
    "test:ops": "tsx src/_selftest18.ts",
    "test:restart": "npm run build && tsx src/_selftest-restart.ts",
    "test:recovery-drill": "npm run build && tsx src/_selftest-recovery-drill.ts",
    "test:workspace-mode": "npm run build && tsx src/_selftest-workspace-mode.ts",
    "test:startup-handshake": "npm run build && tsx src/_selftest-startup-handshake.ts",
    "test:garment-traceability": "tsx src/_selftest-garment-traceability.ts",
    "test:garment-backfill": "tsx src/_selftest-garment-backfill.ts",
    "test:money": "tsx src/_selftest-money.ts",
    "test:reconciliation": "tsx src/_selftest-reconciliation.ts",
    "test:cash-shift": "tsx src/_selftest-cash-shift.ts",
    "test:routes": "tsx src/_selftest-routes.ts",
    "test:hardware": "tsx src/_selftest-hardware.ts",
    "test:diagnostics": "tsx src/_selftest-diagnostics.ts",
    "test:backup-crypto": "tsx src/_selftest-backup-crypto.ts",
    "test:financial-normalization": "tsx src/_selftest-financial-normalization.ts",
    "test:entity-normalization": "tsx src/_selftest-entity-normalization.ts",
    "test:e2e": "tsx src/_selftest-e2e.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.3",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
