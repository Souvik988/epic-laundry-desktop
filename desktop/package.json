{
  "name": "epic-laundry-desktop",
  "version": "0.1.0",
  "author": "Epic BOS",
  "private": true,
  "description": "Offline-first Electron desktop application for Epic Laundry.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:workspace": "node workspace.test.js",
    "test:recovery-policy": "node recovery-policy.test.js",
    "build:server": "npm --prefix ../server run build",
    "manifest": "node scripts/release-manifest.mjs",
    "verify:manifest": "node scripts/verify-release-manifest.mjs",
    "sign:manifest": "node scripts/sign-release-manifest.mjs",
    "verify:signature": "node scripts/verify-release-signature.mjs",
    "test:release-signature": "node scripts/release-signature.test.mjs",
    "pack": "npm run build:server && electron-builder --dir && npm run manifest",
    "dist": "npm run build:server && electron-builder && npm run manifest",
    "dist:win": "npm run build:server && electron-builder --win && npm run manifest"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.epic.laundry",
    "productName": "Epic Laundry",
    "asar": true,
    "disableDefaultIgnoredFiles": true,
    "files": [
      "main.js",
      "recovery-policy.js",
      "preload.js",
      "workspace.js",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!src{,/**/*}",
          "!data{,/**/*}",
          "!package-lock.json",
          "!tsconfig*.json",
          "!README.md"
        ]
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Epic Laundry",
      "runAfterFinish": false
    }
  }
}
